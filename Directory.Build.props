<Project>
  <PropertyGroup>
    <!-- 表示する版は文字列で保持する。数値化すると小数点以下の先頭の零が消えるため、画面には使わない。 -->
    <HWEncVppPreviewVersion>0.01</HWEncVppPreviewVersion>
    <Version>$(HWEncVppPreviewVersion)</Version>
    <InformationalVersion>$(HWEncVppPreviewVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- アセンブリとファイルの版だけは整数へ直し、Windowsの版情報の制約に合わせる。 -->
    <_HWEncVppPreviewNumericVersion>$([System.Version]::Parse('$(HWEncVppPreviewVersion)'))</_HWEncVppPreviewNumericVersion>
    <AssemblyVersion>$(_HWEncVppPreviewNumericVersion).0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
</Project>
