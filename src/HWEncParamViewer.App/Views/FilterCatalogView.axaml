<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HWEncParamViewer.App.Views"
             x:Class="HWEncParamViewer.App.Views.FilterCatalogView">
  <!--
    フィルタの追加の一覧 (設計書 23.2)。用途別の見出しの下に、オプション名と説明の1行目を並べる。
    「＋フィルタを追加」の Flyout と、フィルタが1行もないときの案内の両方で使う
  -->
  <Grid RowDefinitions="Auto,*">
    <TextBox Grid.Row="0" x:Name="SearchBox" Classes="mono" Margin="0,0,0,6"
             PlaceholderText="名前や説明で絞り込み (↑↓ で選択、Enter で追加)" />
    <ListBox Grid.Row="1" x:Name="CatalogList" Classes="catalog"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:CatalogEntry">
          <Panel>
            <TextBlock Classes="completionHeader" Text="{Binding Header}" IsVisible="{Binding IsHeader}" />
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsHeader}">
              <TextBlock Grid.Column="0" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                         Text="{Binding Item.DisplayName, FallbackValue=''}" />
              <TextBlock Grid.Column="1" Classes="subtle" Margin="12,0,0,0" FontSize="11"
                         Text="{Binding Item.Description, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Item.Description, FallbackValue=''}" />
              <TextBlock Grid.Column="2" Classes="subtle" Margin="8,0,0,0" FontSize="11" Text="使用中"
                         IsVisible="{Binding Item.IsInUse, FallbackValue=False}" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
