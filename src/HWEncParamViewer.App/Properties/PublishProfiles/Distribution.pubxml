<Project>
  <!-- 配布の設定はAppのcsprojに集約する。参照プロジェクトのPDBも配布対象から外す。 -->
  <Target Name="RemoveDistributionSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
