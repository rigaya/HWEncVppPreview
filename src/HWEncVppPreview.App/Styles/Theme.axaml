<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    見た目の方針 (設計書 17.3):
    - プレビュー領域は無彩色の中間グレー。画像の色の評価を周囲の色で狂わせない
    - アクセント色は選択・フォーカスだけに使う
    - オプションとヘルプは等幅フォント
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="BarBackgroundBrush" Color="#E9E9E9" />
          <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#606060" />
          <SolidColorBrush x:Key="HeaderTextBrush" Color="#303030" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="BarBackgroundBrush" Color="#252525" />
          <SolidColorBrush x:Key="DividerBrush" Color="#3C3C3C" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="HeaderTextBrush" Color="#E0E0E0" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- テーマに依存させない色 -->
      <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B0000000" />
      <SolidColorBrush x:Key="OverlayTextBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#E0701818" />
      <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFFFF" />

      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, DejaVu Sans Mono, Noto Sans Mono CJK JP, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 区画の見出し -->
  <Style Selector="TextBlock.header">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- オプションのテキスト (等幅) -->
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="SelectableTextBlock.help">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="10,6" />
  </Style>

  <!-- 小さなアイコンボタン (コマ送り・行の削除など) -->
  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.small, ToggleButton.small">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 画像の上に重ねる状態表示 -->
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{StaticResource OverlayBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="12" />
  </Style>

  <!-- セグメントボタン (表示モードの切替)。選択中だけアクセント色 -->
  <Style Selector="Button.seg">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.seg.first">
    <Setter Property="CornerRadius" Value="4,0,0,4" />
  </Style>
  <Style Selector="Button.seg.last">
    <Setter Property="CornerRadius" Value="0,4,4,0" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="ToggleButton.mini">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- フィルタ行の補完の一覧 (設計書 21.7) -->
  <Style Selector="Border.completion">
    <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #40000000" />
    <Setter Property="Width" Value="460" />
  </Style>
  <Style Selector="ListBox.completion">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MaxHeight" Value="320" />
    <Setter Property="Padding" Value="0,0,0,4" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="TextBlock.completionHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- フィルタの一覧と、パラメータのフォーム (設計書 23.2) -->
  <Style Selector="ListBox.filters, ListBox.catalog">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.filters ListBoxItem">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.catalog ListBoxItem">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBlock.filterName">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.filterSummary">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- パラメータ名。行に書かれている (既定値から変えた) ものはアクセント色で強調する -->
  <Style Selector="TextBlock.paramName">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.paramName.set">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="TextBlock.paramDesc">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.paramError">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#D04848" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.paramValue">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <!-- ステータスバーの選択欄 (表示言語)。バーの高さを変えない -->
  <Style Selector="ComboBox.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.param">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <!-- 既定に戻すボタンは、書かれていないときは見えないだけで場所は取る -->
  <Style Selector="Button.reset:disabled">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <!-- 語と数値の選択のボタンの並び。角丸は外枠でまとめて付ける -->
  <Style Selector="Border.segGroup">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.segGroup Button.seg">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Slider.param">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-8" />
  </Style>
</Styles>
