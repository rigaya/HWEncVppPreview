<Project Sdk="Microsoft.NET.Sdk">
  <!-- 画面デザイン確認用: Headless で MainWindow を描画して PNG に保存する (開発用ツール。CI のテストではない) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HWEncVppPreview.App\HWEncVppPreview.App.csproj" />
  </ItemGroup>
</Project>
