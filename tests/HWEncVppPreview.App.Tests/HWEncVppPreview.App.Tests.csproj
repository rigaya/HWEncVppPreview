<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HWEncVppPreview.App\HWEncVppPreview.App.csproj" />
    <ProjectReference Include="..\FakeEncoder\FakeEncoder.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\HWEncVppPreview.Tests\FakeTimeProvider.cs" Link="Testing\FakeTimeProvider.cs" />
    <Compile Include="..\HWEncVppPreview.Tests\FakeLogFiles.cs" Link="Testing\FakeLogFiles.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Data\help\**" Link="Data\help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestTimeouts.cs" Link="Testing\TestTimeouts.cs" />
  </ItemGroup>
</Project>
